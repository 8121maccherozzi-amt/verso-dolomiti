<workout_file>
    <author>Coach Library</author>
    <name>Sweet Spot L04 - 3x10 @ 90%</name>
    <description>PICK THIS WHEN: Your weekly sweet spot session during base and build. Repeat a level 1-2 weeks before moving up. Shorter blocks: easier to pace, good first choice at a new level.
DAY TYPE: Medium.

Sweet Spot - level 4 of 10. 3x10 @ 90%.

Structure: 10 min warm-up, 3 x (10 min @ 90% / 5 min @ 55%), 5 min cool-down.

Coach notes: The standard sweet spot intensity. If the third block drops by more than 3%, you started too hard.

Estimated TSS: 57.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Sweet Spot"/>
        <tag name="Level 4"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Sweet spot session. Build the warm-up gradually."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <IntervalsT Repeat="3" OnDuration="600" OffDuration="300" OnPower="0.90" OffPower="0.55">
            <textevent timeoffset="0" message="10 min at 90% - comfortably hard."/>
            <textevent timeoffset="300" message="Halfway. Breathe deep, relax the shoulders."/>
            <textevent timeoffset="540" message="Last minute - hold the number."/>
            <textevent timeoffset="600" message="Recover - easy spin."/>
        </IntervalsT>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
