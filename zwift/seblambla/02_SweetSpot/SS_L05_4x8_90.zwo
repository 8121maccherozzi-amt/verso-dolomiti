<workout_file>
    <author>Coach Library</author>
    <name>Sweet Spot L05 - 4x8 @ 90%</name>
    <description>PICK THIS WHEN: Your weekly sweet spot session during base and build. Repeat a level 1-2 weeks before moving up. Shorter blocks: easier to pace, good first choice at a new level.
DAY TYPE: Medium.

Sweet Spot - level 5 of 10. 4x8 @ 90%.

Structure: 10 min warm-up, 4 x (8 min @ 90% / 3 min @ 55%), 6 min cool-down.

Coach notes: Four blocks with 3-minute recoveries. Stay seated, power line flat.

Estimated TSS: 58.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Sweet Spot"/>
        <tag name="Level 5"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Sweet spot session. Build the warm-up gradually."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <IntervalsT Repeat="4" OnDuration="480" OffDuration="180" OnPower="0.90" OffPower="0.55">
            <textevent timeoffset="0" message="8 min at 90% - comfortably hard."/>
            <textevent timeoffset="240" message="Halfway. Breathe deep, relax the shoulders."/>
            <textevent timeoffset="420" message="Last minute - hold the number."/>
            <textevent timeoffset="480" message="Recover - easy spin."/>
        </IntervalsT>
        <Cooldown Duration="360" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
