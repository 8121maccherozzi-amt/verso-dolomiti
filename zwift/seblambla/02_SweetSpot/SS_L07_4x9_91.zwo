<workout_file>
    <author>Coach Library</author>
    <name>Sweet Spot L07 - 4x9 @ 91%</name>
    <description>PICK THIS WHEN: When L06 feels comfortable. Solid aerobic work without the cost of threshold. Shorter blocks: easier to pace, good first choice at a new level.
DAY TYPE: Medium.

Sweet Spot - level 7 of 10. 4x9 @ 91%.

Structure: 10 min warm-up, 4 x (9 min @ 91% / 2:15 min @ 55%), 5 min cool-down.

Coach notes: Four 9-minute blocks at 91% with short 2:15 recoveries. More blocks, less rest - the fatigue builds through the set.

Estimated TSS: 63.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Sweet Spot"/>
        <tag name="Level 7"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Sweet spot session. Build the warm-up gradually."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <IntervalsT Repeat="4" OnDuration="540" OffDuration="135" OnPower="0.91" OffPower="0.55">
            <textevent timeoffset="0" message="9 min at 91% - sweet spot, comfortably hard."/>
            <textevent timeoffset="270" message="Halfway. Stay smooth."/>
            <textevent timeoffset="480" message="Last minute - hold the number."/>
            <textevent timeoffset="540" message="Recover - easy spin."/>
        </IntervalsT>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
