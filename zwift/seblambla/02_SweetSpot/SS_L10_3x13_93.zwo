<workout_file>
    <author>Coach Library</author>
    <name>Sweet Spot L10 - 3x13 @ 93%</name>
    <description>PICK THIS WHEN: Top of the sweet spot ladder: the most work that fits the format. After this, move to the 90-minute set or to threshold. Shorter blocks: easier to pace, good first choice at a new level.
DAY TYPE: Medium.

Sweet Spot - level 10 of 10. 3x13 @ 93%.

Structure: 10 min warm-up, 3 x (13 min @ 93% / 2 min @ 55%), 5 min cool-down.

Coach notes: 39 minutes at the top of sweet spot. The hardest sweet spot session in the library.

Estimated TSS: 68.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Sweet Spot"/>
        <tag name="Level 10"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Sweet spot session. Build the warm-up gradually."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <IntervalsT Repeat="3" OnDuration="780" OffDuration="120" OnPower="0.93" OffPower="0.55">
            <textevent timeoffset="0" message="13 min at 93% - comfortably hard."/>
            <textevent timeoffset="390" message="Halfway. Breathe deep, relax the shoulders."/>
            <textevent timeoffset="720" message="Last minute - hold the number."/>
            <textevent timeoffset="780" message="Recover - easy spin."/>
        </IntervalsT>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
