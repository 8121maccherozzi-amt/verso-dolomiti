<workout_file>
    <author>Coach Library</author>
    <name>Sweet Spot 90 L10 - 3x20 @ 93%</name>
    <description>PICK THIS WHEN: Top of the sweet spot ladder: the biggest sweet spot blocks in the library; a real test of aerobic endurance. Shorter blocks: easier to pace, good first choice at a new level.
DAY TYPE: Medium to hard.

Sweet Spot 90 - level 10 of 10. 3x20 @ 93%.

Structure: 10 min warm-up, 3 x (20 min @ 93% / 3 min @ 55%), 6 min @ 65%, 5 min cool-down.

Coach notes: 3 long blocks of 20 min at 93%. Long sweet spot blocks are what the 90-minute format is for - pace the first one conservatively.

Estimated TSS: 104.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Sweet Spot"/>
        <tag name="Level 10"/>
        <tag name="90 min"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Sweet spot session, 90 minutes. Build the warm-up gradually."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <IntervalsT Repeat="3" OnDuration="1200" OffDuration="180" OnPower="0.93" OffPower="0.55">
            <textevent timeoffset="0" message="20 min at 93% - sweet spot, comfortably hard."/>
            <textevent timeoffset="600" message="Halfway. Stay smooth."/>
            <textevent timeoffset="1140" message="Last minute - hold the number."/>
            <textevent timeoffset="1200" message="Recover - easy spin."/>
        </IntervalsT>
        <SteadyState Duration="360" Power="0.65">
            <textevent timeoffset="0" message="6 min steady Zone 2 at 65% to round off the ride. Relaxed, conversational pace."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
