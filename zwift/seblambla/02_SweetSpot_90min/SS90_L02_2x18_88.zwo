<workout_file>
    <author>Coach Library</author>
    <name>Sweet Spot 90 L02 - 2x18 @ 88%</name>
    <description>PICK THIS WHEN: First weeks of a base phase, after a break, or as a lighter sweet spot week. Long blocks: closest to a steady climb or time-trial feel.
DAY TYPE: Medium to hard.

Sweet Spot 90 - level 2 of 10. 2x18 @ 88%.

Structure: 10 min warm-up, 5 min @ 65%, 2 x (18 min @ 88% / 5 min @ 55%), 24 min @ 65%, 5 min cool-down.

Coach notes: 2 x 18 min at 88% - more total work than any 60-minute session at this intensity, with full recoveries.

Estimated TSS: 80.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Sweet Spot"/>
        <tag name="Level 2"/>
        <tag name="90 min"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Sweet spot session, 90 minutes. Build the warm-up gradually."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="300" Power="0.65">
            <textevent timeoffset="0" message="5 min Zone 2 to settle in before the main set."/>
        </SteadyState>
        <IntervalsT Repeat="2" OnDuration="1080" OffDuration="300" OnPower="0.88" OffPower="0.55">
            <textevent timeoffset="0" message="18 min at 88% - sweet spot, comfortably hard."/>
            <textevent timeoffset="540" message="Halfway. Stay smooth."/>
            <textevent timeoffset="1020" message="Last minute - hold the number."/>
            <textevent timeoffset="1080" message="Recover - easy spin."/>
        </IntervalsT>
        <SteadyState Duration="1440" Power="0.65">
            <textevent timeoffset="0" message="24 min steady Zone 2 at 65% to round off the ride. Relaxed, conversational pace."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
