<workout_file>
    <author>Coach Library</author>
    <name>Sweet Spot 90 L05 - 2x22 @ 90%</name>
    <description>PICK THIS WHEN: The long sweet spot session (90 min), for the weekend ride or when the 60-min set at this level feels easy during base and build. Repeat a level 1-2 weeks before moving up. Long blocks: closest to a steady climb or time-trial feel.
DAY TYPE: Medium to hard.

Sweet Spot 90 - level 5 of 10. 2x22 @ 90%.

Structure: 10 min warm-up, 5 min @ 65%, 2 x (22 min @ 90% / 5 min @ 55%), 16 min @ 65%, 5 min cool-down.

Coach notes: 2 long blocks of 22 min at 90%. Long sweet spot blocks are what the 90-minute format is for - pace the first one conservatively.

Estimated TSS: 88.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Sweet Spot"/>
        <tag name="Level 5"/>
        <tag name="90 min"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Sweet spot session, 90 minutes. Build the warm-up gradually."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="300" Power="0.65">
            <textevent timeoffset="0" message="5 min Zone 2 to settle in before the main set."/>
        </SteadyState>
        <IntervalsT Repeat="2" OnDuration="1320" OffDuration="300" OnPower="0.90" OffPower="0.55">
            <textevent timeoffset="0" message="22 min at 90% - sweet spot, comfortably hard."/>
            <textevent timeoffset="660" message="Halfway. Stay smooth."/>
            <textevent timeoffset="1260" message="Last minute - hold the number."/>
            <textevent timeoffset="1320" message="Recover - easy spin."/>
        </IntervalsT>
        <SteadyState Duration="960" Power="0.65">
            <textevent timeoffset="0" message="16 min steady Zone 2 at 65% to round off the ride. Relaxed, conversational pace."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
