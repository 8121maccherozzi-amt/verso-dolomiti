<workout_file>
    <author>Coach Library</author>
    <name>Endurance 90 L01 - Recovery Spin 70 min @ 55%</name>
    <description>PICK THIS WHEN: Recovery day: the day after a hard session, or when tired. Should feel almost too easy. The 90-minute set is for the long ride of the week; ride one level below your 60-minute endurance level if in doubt.
DAY TYPE: Easy to medium.

Endurance 90 - level 1 of 10. Recovery Spin 70 min @ 55%.

Structure: 10 min warm-up, 70 min @ 55%, 10 min cool-down.

Coach notes: Long but very easy. Finish fresher than you started; lower the bias if 55% feels like work. Eat 40-60 g of carbohydrate per hour on rides this long.

Estimated TSS: 43.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Endurance"/>
        <tag name="Level 1"/>
        <tag name="90 min"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.40" PowerHigh="0.52">
            <textevent timeoffset="0" message="Long endurance ride: 90 minutes. Warm up easy and settle into a relaxed rhythm. Have food and drink within reach."/>
            <textevent timeoffset="480" message="2 minutes to the main set."/>
        </Warmup>
        <SteadyState Duration="4200" Power="0.55">
            <textevent timeoffset="0" message="70 min at 55% - steady Zone 2. Conversational pace."/>
            <textevent timeoffset="900" message="15 min into this block. Drink, and eat something every 30-40 minutes."/>
            <textevent timeoffset="1800" message="30 min in. Check your position: relaxed shoulders, light grip, no surging."/>
            <textevent timeoffset="2700" message="45 min into this block. Drink, and eat something every 30-40 minutes."/>
            <textevent timeoffset="3600" message="60 min in. Check your position: relaxed shoulders, light grip, no surging."/>
            <textevent timeoffset="3900" message="Last 5 minutes of this block. Keep the pressure even."/>
        </SteadyState>
        <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.40">
            <textevent timeoffset="0" message="Well done - 90 minutes in the bank. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
