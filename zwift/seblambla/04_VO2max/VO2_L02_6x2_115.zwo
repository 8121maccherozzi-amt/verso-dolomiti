<workout_file>
    <author>Coach Library</author>
    <name>VO2max L02 - 6x2 @ 115%</name>
    <description>PICK THIS WHEN: First VO2max sessions of a build phase, or a maintenance dose. Hard but short. Classic long intervals: the most reliable VO2max stimulus.
DAY TYPE: HARD.

VO2max - level 2 of 10. 6x2 @ 115%.

Structure: 12 min warm-up, 6 x (2 min @ 115% / 2 min @ 50%), 16 min @ 65%, 8 min cool-down.

Coach notes: Six 2-minute efforts with equal recovery. Short enough to go hard.

Estimated TSS: 53.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="VO2max"/>
        <tag name="Level 2"/>
    </tags>
    <workout>
        <Warmup Duration="720" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="VO2max session. Warm up thoroughly and add two 15 s accelerations in the last 3 minutes."/>
            <textevent timeoffset="600" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <IntervalsT Repeat="6" OnDuration="120" OffDuration="120" OnPower="1.15" OffPower="0.50">
            <textevent timeoffset="0" message="GO! 2 min at 115%. Commit from the first pedal stroke."/>
            <textevent timeoffset="120" message="Recover - easy spin."/>
        </IntervalsT>
        <SteadyState Duration="960" Power="0.65">
            <textevent timeoffset="0" message="Main set done. 16 min of steady Zone 2 at 65% to finish - relaxed but not soft."/>
        </SteadyState>
        <Cooldown Duration="480" PowerLow="0.55" PowerHigh="0.40">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
