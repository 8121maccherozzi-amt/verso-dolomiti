<workout_file>
    <author>Coach Library</author>
    <name>Openers 45 min</name>
    <description>PICK THIS WHEN: The day before an event when you want a bit more volume.
DAY TYPE: Special.

Tests &amp; Openers. Openers 45 min.

Structure: 10 min warm-up, 5 min @ 70%, 2 x (3 min @ 95% / 3 min @ 60%), 3 x (30 s @ 130% / 2:30 min @ 60%), 5 min @ 65%, 4 min cool-down.

Coach notes: Longer activation for riders who like more volume the day before: two 3-minute threshold touches and three 30-second accelerations.

Duration: 45 min. Estimated TSS: 36 (tests depend on your effort).</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Test"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.70">
            <textevent timeoffset="0" message="Openers - the day before an event. Short, sharp, no fatigue."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="300" Power="0.70">
            <textevent timeoffset="0" message="5 min steady Zone 2 at 70%. Relaxed, conversational pace."/>
        </SteadyState>
        <IntervalsT Repeat="2" OnDuration="180" OffDuration="180" OnPower="0.95" OffPower="0.60">
            <textevent timeoffset="0" message="3 min at 95% - just under threshold, controlled."/>
            <textevent timeoffset="120" message="Last minute - hold the number."/>
            <textevent timeoffset="180" message="Easy."/>
        </IntervalsT>
        <IntervalsT Repeat="3" OnDuration="30" OffDuration="150" OnPower="1.30" OffPower="0.60">
            <textevent timeoffset="0" message="30 s at 130% - snappy."/>
            <textevent timeoffset="30" message="Easy spin."/>
        </IntervalsT>
        <SteadyState Duration="300" Power="0.65">
            <textevent timeoffset="0" message="5 min steady Zone 2 at 65%. Relaxed, conversational pace."/>
        </SteadyState>
        <Cooldown Duration="240" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
