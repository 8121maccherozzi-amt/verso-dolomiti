        <SteadyState Duration="60" Power="1.72">
            <textevent timeoffset="0" message="Step 21: 172%."/>
        </SteadyState>
        <SteadyState Duration="60" Power="1.78">
            <textevent timeoffset="0" message="Step 22: 178%."/>
        </SteadyState>
        <Cooldown Duration="600" PowerLow="0.50" PowerHigh="0.35">
            <textevent timeoffset="0" message="Stop as soon as you cannot hold a step, then spin easy. New FTP = 75% of your best 1-minute power from this ride."/>
        </Cooldown>
    </workout>
