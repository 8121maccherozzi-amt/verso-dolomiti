            <textevent timeoffset="0" message="Step 8: 94%."/>
        </SteadyState>
        <SteadyState Duration="60" Power="1.00">
            <textevent timeoffset="0" message="Step 9: 100%."/>
        </SteadyState>
        <SteadyState Duration="60" Power="1.06">
            <textevent timeoffset="0" message="Step 10: 106%."/>
        </SteadyState>
        <SteadyState Duration="60" Power="1.12">
            <textevent timeoffset="0" message="Step 11: 112%."/>
        </SteadyState>
