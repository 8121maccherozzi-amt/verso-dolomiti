<workout_file>
    <author>Coach Library</author>
    <name>Endurance L02 - Easy Z2 45 min @ 58%</name>
    <description>PICK THIS WHEN: Recovery day: the day after a hard session, or when tired. Should feel almost too easy.
DAY TYPE: Easy.

Endurance - level 2 of 10. Easy Z2 45 min @ 58%.

Structure: 10 min warm-up, 45 min @ 58%, 5 min cool-down.

Coach notes: Low Zone 2 all the way. Conversational pace, no surges.

Estimated TSS: 31.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Endurance"/>
        <tag name="Level 2"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.40" PowerHigh="0.55">
            <textevent timeoffset="0" message="Endurance ride. Warm up easy and settle into a relaxed rhythm."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="2700" Power="0.58">
            <textevent timeoffset="0" message="45 min at 58% - steady Zone 2. Conversational pace."/>
            <textevent timeoffset="1350" message="Halfway. Check your position: relaxed shoulders, light grip."/>
            <textevent timeoffset="2400" message="Last 5 minutes. Keep the pressure even."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.55" PowerHigh="0.40">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
