<workout_file>
    <author>Coach Library</author>
    <name>Mixed L05 - Group Ride Simulation</name>
    <description>PICK THIS WHEN: Medium day with race-like changes of pace. Good a few days out from an event.
DAY TYPE: Medium to hard.

Mixed - level 5 of 10. Group Ride Simulation.

Structure: 10 min warm-up, 5 min @ 72%, 6 x (1 min @ 110% / 4 min @ 72%), 5 min @ 95%, 5 min @ 60%, 5 min cool-down.

Coach notes: Mimics a brisk group ride: steady Zone 2 with six 1-minute surges, then a 5-minute threshold run-in. Good race-feel session with moderate load.

Estimated TSS: 56.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Mixed"/>
        <tag name="Level 5"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75">
            <textevent timeoffset="0" message="Mixed session today. Warm up progressively."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="300" Power="0.72">
            <textevent timeoffset="0" message="5 min steady Zone 2 at 72%. Relaxed, conversational pace."/>
        </SteadyState>
        <IntervalsT Repeat="6" OnDuration="60" OffDuration="240" OnPower="1.10" OffPower="0.72">
            <textevent timeoffset="0" message="SURGE: 1 min at 110% - close the gap!"/>
            <textevent timeoffset="60" message="Back in the wheels at 72%. Recover while riding."/>
        </IntervalsT>
        <SteadyState Duration="300" Power="0.95">
            <textevent timeoffset="0" message="Final 5 min at 95% - the run-in to the line. Empty the tank steadily."/>
            <textevent timeoffset="240" message="Last minute - hold the number."/>
        </SteadyState>
        <SteadyState Duration="300" Power="0.60">
            <textevent timeoffset="0" message="Recover: 5 min easy. Drink."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
