<workout_file>
    <author>Coach Library</author>
    <name>Threshold 90 L10 - 2x30 @ 98%</name>
    <description>PICK THIS WHEN: Peak threshold sessions: 2x25, 3x18, 2x30 - the longest threshold work in the library. Only when fresh; one per week, and follow it with an easy day. Long blocks: time-trial pacing practice.
DAY TYPE: HARD.

Threshold 90 - level 10 of 10. 2x30 @ 98%.

Structure: 10 min warm-up, 2 x (30 min @ 98% / 6 min @ 55%), 8 min cool-down.

Coach notes: 2 long blocks of 30 min at 98%. Long threshold blocks are what the 90-minute format is for - pace the first one conservatively.

Estimated TSS: 112.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Threshold"/>
        <tag name="Level 10"/>
        <tag name="90 min"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Threshold session, 90 minutes. Warm up properly - the main set starts hard."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <IntervalsT Repeat="2" OnDuration="1800" OffDuration="360" OnPower="0.98" OffPower="0.55">
            <textevent timeoffset="0" message="30 min at 98% - threshold. Pace it like a time trial."/>
            <textevent timeoffset="900" message="Halfway. Stay smooth."/>
            <textevent timeoffset="1740" message="Last minute - hold the number."/>
            <textevent timeoffset="1800" message="Recover - easy spin."/>
        </IntervalsT>
        <Cooldown Duration="480" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
