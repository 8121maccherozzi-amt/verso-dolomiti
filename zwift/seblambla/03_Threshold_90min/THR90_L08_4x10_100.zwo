<workout_file>
    <author>Coach Library</author>
    <name>Threshold 90 L08 - 4x10 @ 100%</name>
    <description>PICK THIS WHEN: Advanced threshold: for when L06 is completed with power holding steady. Expect to be tired tomorrow. Shorter intervals at higher power: pick when you want quality over duration.
DAY TYPE: HARD.

Threshold 90 - level 8 of 10. 4x10 @ 100%.

Structure: 10 min warm-up, 5 min @ 65%, 4 x (10 min @ 100% / 4 min @ 55%), 14 min @ 65%, 5 min cool-down.

Coach notes: 4 x 10 min at 100% - more total work than any 60-minute session at this intensity, with full recoveries.

Estimated TSS: 97.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Threshold"/>
        <tag name="Level 8"/>
        <tag name="90 min"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Threshold session, 90 minutes. Warm up properly - the main set starts hard."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="300" Power="0.65">
            <textevent timeoffset="0" message="5 min Zone 2 to settle in before the main set."/>
        </SteadyState>
        <IntervalsT Repeat="4" OnDuration="600" OffDuration="240" OnPower="1.00" OffPower="0.55">
            <textevent timeoffset="0" message="10 min at 100% - threshold. Pace it like a time trial."/>
            <textevent timeoffset="300" message="Halfway. Stay smooth."/>
            <textevent timeoffset="540" message="Last minute - hold the number."/>
            <textevent timeoffset="600" message="Recover - easy spin."/>
        </IntervalsT>
        <SteadyState Duration="840" Power="0.65">
            <textevent timeoffset="0" message="14 min steady Zone 2 at 65% to round off the ride. Relaxed, conversational pace."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
