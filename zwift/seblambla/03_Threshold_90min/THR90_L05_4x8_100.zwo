<workout_file>
    <author>Coach Library</author>
    <name>Threshold 90 L05 - 4x8 @ 100%</name>
    <description>PICK THIS WHEN: The long threshold session (90 min): the hard day of the week when you have time, or race-specific preparation for time trials and long climbs. Needs fresh legs and a proper meal beforehand. Shorter intervals at higher power: pick when you want quality over duration.
DAY TYPE: HARD.

Threshold 90 - level 5 of 10. 4x8 @ 100%.

Structure: 10 min warm-up, 5 min @ 65%, 4 x (8 min @ 100% / 4 min @ 55%), 22 min @ 65%, 5 min cool-down.

Coach notes: 4 x 8 min at 100% - more total work than any 60-minute session at this intensity, with full recoveries.

Estimated TSS: 89.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Threshold"/>
        <tag name="Level 5"/>
        <tag name="90 min"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Threshold session, 90 minutes. Warm up properly - the main set starts hard."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="300" Power="0.65">
            <textevent timeoffset="0" message="5 min Zone 2 to settle in before the main set."/>
        </SteadyState>
        <IntervalsT Repeat="4" OnDuration="480" OffDuration="240" OnPower="1.00" OffPower="0.55">
            <textevent timeoffset="0" message="8 min at 100% - threshold. Pace it like a time trial."/>
            <textevent timeoffset="240" message="Halfway. Stay smooth."/>
            <textevent timeoffset="420" message="Last minute - hold the number."/>
            <textevent timeoffset="480" message="Recover - easy spin."/>
        </IntervalsT>
        <SteadyState Duration="1320" Power="0.65">
            <textevent timeoffset="0" message="22 min steady Zone 2 at 65% to round off the ride. Relaxed, conversational pace."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
