<workout_file>
    <author>Coach Library</author>
    <name>Threshold 90 L06 - 2x20 @ 97%</name>
    <description>PICK THIS WHEN: The long threshold session (90 min): the hard day of the week when you have time, or race-specific preparation for time trials and long climbs. Needs fresh legs and a proper meal beforehand. Long blocks: time-trial pacing practice.
DAY TYPE: HARD.

Threshold 90 - level 6 of 10. 2x20 @ 97%.

Structure: 10 min warm-up, 5 min @ 65%, 2 x (20 min @ 97% / 6 min @ 55%), 18 min @ 65%, 5 min cool-down.

Coach notes: 2 long blocks of 20 min at 97%. Long threshold blocks are what the 90-minute format is for - pace the first one conservatively.

Estimated TSS: 94.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Threshold"/>
        <tag name="Level 6"/>
        <tag name="90 min"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Threshold session, 90 minutes. Warm up properly - the main set starts hard."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="300" Power="0.65">
            <textevent timeoffset="0" message="5 min Zone 2 to settle in before the main set."/>
        </SteadyState>
        <IntervalsT Repeat="2" OnDuration="1200" OffDuration="360" OnPower="0.97" OffPower="0.55">
            <textevent timeoffset="0" message="20 min at 97% - threshold. Pace it like a time trial."/>
            <textevent timeoffset="600" message="Halfway. Stay smooth."/>
            <textevent timeoffset="1140" message="Last minute - hold the number."/>
            <textevent timeoffset="1200" message="Recover - easy spin."/>
        </IntervalsT>
        <SteadyState Duration="1080" Power="0.65">
            <textevent timeoffset="0" message="18 min steady Zone 2 at 65% to round off the ride. Relaxed, conversational pace."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
