<workout_file>
    <author>Coach Library</author>
    <name>Threshold 90 L01 - 2x10 @ 95%</name>
    <description>PICK THIS WHEN: Introduction to threshold work, or a lighter threshold week. Manageable even when not fully fresh. Long blocks: time-trial pacing practice.
DAY TYPE: HARD.

Threshold 90 - level 1 of 10. 2x10 @ 95%.

Structure: 10 min warm-up, 5 min @ 65%, 2 x (10 min @ 95% / 5 min @ 55%), 40 min @ 65%, 5 min cool-down.

Coach notes: 2 x 10 min at 95% - more total work than any 60-minute session at this intensity, with full recoveries.

Estimated TSS: 76.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Threshold"/>
        <tag name="Level 1"/>
        <tag name="90 min"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Threshold session, 90 minutes. Warm up properly - the main set starts hard."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="300" Power="0.65">
            <textevent timeoffset="0" message="5 min Zone 2 to settle in before the main set."/>
        </SteadyState>
        <IntervalsT Repeat="2" OnDuration="600" OffDuration="300" OnPower="0.95" OffPower="0.55">
            <textevent timeoffset="0" message="10 min at 95% - threshold. Pace it like a time trial."/>
            <textevent timeoffset="300" message="Halfway. Stay smooth."/>
            <textevent timeoffset="540" message="Last minute - hold the number."/>
            <textevent timeoffset="600" message="Recover - easy spin."/>
        </IntervalsT>
        <SteadyState Duration="2400" Power="0.65">
            <textevent timeoffset="0" message="40 min steady Zone 2 at 65% to round off the ride. Relaxed, conversational pace."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
