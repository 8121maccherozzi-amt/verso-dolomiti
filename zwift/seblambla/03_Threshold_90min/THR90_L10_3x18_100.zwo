<workout_file>
    <author>Coach Library</author>
    <name>Threshold 90 L10 - 3x18 @ 100%</name>
    <description>PICK THIS WHEN: Peak threshold sessions: 2x25, 3x18, 2x30 - the longest threshold work in the library. Only when fresh; one per week, and follow it with an easy day.
DAY TYPE: HARD.

Threshold 90 - level 10 of 10. 3x18 @ 100%.

Structure: 10 min warm-up, 5 min @ 65%, 3 x (18 min @ 100% / 5 min @ 55%), 6 min cool-down.

Coach notes: 3 x 18 min at 100% - more total work than any 60-minute session at this intensity, with full recoveries.

Estimated TSS: 111.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Threshold"/>
        <tag name="Level 10"/>
        <tag name="90 min"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Threshold session, 90 minutes. Warm up properly - the main set starts hard."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="300" Power="0.65">
            <textevent timeoffset="0" message="5 min Zone 2 to settle in before the main set."/>
        </SteadyState>
        <IntervalsT Repeat="3" OnDuration="1080" OffDuration="300" OnPower="1.00" OffPower="0.55">
            <textevent timeoffset="0" message="18 min at 100% - threshold. Pace it like a time trial."/>
            <textevent timeoffset="540" message="Halfway. Stay smooth."/>
            <textevent timeoffset="1020" message="Last minute - hold the number."/>
            <textevent timeoffset="1080" message="Recover - easy spin."/>
        </IntervalsT>
        <Cooldown Duration="360" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
