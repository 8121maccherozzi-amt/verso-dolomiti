<workout_file>
    <author>Coach Library</author>
    <name>Threshold 90 L09 - 2x25 @ 98%</name>
    <description>PICK THIS WHEN: Peak threshold sessions: 2x25, 3x18, 2x30 - the longest threshold work in the library. Only when fresh; one per week, and follow it with an easy day. Long blocks: time-trial pacing practice.
DAY TYPE: HARD.

Threshold 90 - level 9 of 10. 2x25 @ 98%.

Structure: 10 min warm-up, 5 min @ 65%, 2 x (25 min @ 98% / 6 min @ 55%), 8 min @ 65%, 5 min cool-down.

Coach notes: 2 long blocks of 25 min at 98%. Long threshold blocks are what the 90-minute format is for - pace the first one conservatively.

Estimated TSS: 104.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Threshold"/>
        <tag name="Level 9"/>
        <tag name="90 min"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Threshold session, 90 minutes. Warm up properly - the main set starts hard."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="300" Power="0.65">
            <textevent timeoffset="0" message="5 min Zone 2 to settle in before the main set."/>
        </SteadyState>
        <IntervalsT Repeat="2" OnDuration="1500" OffDuration="360" OnPower="0.98" OffPower="0.55">
            <textevent timeoffset="0" message="25 min at 98% - threshold. Pace it like a time trial."/>
            <textevent timeoffset="750" message="Halfway. Stay smooth."/>
            <textevent timeoffset="1440" message="Last minute - hold the number."/>
            <textevent timeoffset="1500" message="Recover - easy spin."/>
        </IntervalsT>
        <SteadyState Duration="480" Power="0.65">
            <textevent timeoffset="0" message="8 min steady Zone 2 at 65% to round off the ride. Relaxed, conversational pace."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
