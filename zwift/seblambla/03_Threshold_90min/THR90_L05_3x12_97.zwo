<workout_file>
    <author>Coach Library</author>
    <name>Threshold 90 L05 - 3x12 @ 97%</name>
    <description>PICK THIS WHEN: The long threshold session (90 min): the hard day of the week when you have time, or race-specific preparation for time trials and long climbs. Needs fresh legs and a proper meal beforehand.
DAY TYPE: HARD.

Threshold 90 - level 5 of 10. 3x12 @ 97%.

Structure: 10 min warm-up, 5 min @ 65%, 3 x (12 min @ 97% / 4 min @ 55%), 22 min @ 65%, 5 min cool-down.

Coach notes: 3 x 12 min at 97% - more total work than any 60-minute session at this intensity, with full recoveries.

Estimated TSS: 91.</description>
    <sportType>bike</sportType>
    <tags>
        <tag name="Threshold"/>
        <tag name="Level 5"/>
        <tag name="90 min"/>
    </tags>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.80">
            <textevent timeoffset="0" message="Threshold session, 90 minutes. Warm up properly - the main set starts hard."/>
            <textevent timeoffset="480" message="2 minutes to the main set. Lift the effort slightly."/>
        </Warmup>
        <SteadyState Duration="300" Power="0.65">
            <textevent timeoffset="0" message="5 min Zone 2 to settle in before the main set."/>
        </SteadyState>
        <IntervalsT Repeat="3" OnDuration="720" OffDuration="240" OnPower="0.97" OffPower="0.55">
            <textevent timeoffset="0" message="12 min at 97% - threshold. Pace it like a time trial."/>
            <textevent timeoffset="360" message="Halfway. Stay smooth."/>
            <textevent timeoffset="660" message="Last minute - hold the number."/>
            <textevent timeoffset="720" message="Recover - easy spin."/>
        </IntervalsT>
        <SteadyState Duration="1320" Power="0.65">
            <textevent timeoffset="0" message="22 min steady Zone 2 at 65% to round off the ride. Relaxed, conversational pace."/>
        </SteadyState>
        <Cooldown Duration="300" PowerLow="0.60" PowerHigh="0.45">
            <textevent timeoffset="0" message="Well done. Cool down easy."/>
        </Cooldown>
    </workout>
</workout_file>
